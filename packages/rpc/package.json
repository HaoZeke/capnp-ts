{
  "name": "@haozeke/capnp-rpc",
  "version": "0.1.0-dev",
  "description": "Cap'n Proto RPC vat for the pure TypeScript runtime (levels 1 through 4)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoZeke/capnp-ts.git",
    "directory": "packages/rpc"
  },
  "homepage": "https://github.com/HaoZeke/capnp-ts#readme",
  "bugs": {
    "url": "https://github.com/HaoZeke/capnp-ts/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "license": "MIT",
  "scripts": {
    "test": "bun run --cwd ../.. build && bun test --timeout 10000 test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup",
    "prepack": "tsup",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "dependencies": {
    "@haozeke/capnp": "^0.1.0-dev"
  }
}
