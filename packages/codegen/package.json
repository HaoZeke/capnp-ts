{
  "name": "@haozeke/capnpc-ts",
  "version": "0.1.0-dev",
  "description": "Cap'n Proto schema compiler plugin for TypeScript",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoZeke/capnp-ts.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://github.com/HaoZeke/capnp-ts#readme",
  "bugs": {
    "url": "https://github.com/HaoZeke/capnp-ts/issues"
  },
  "bin": {
    "capnpc-ts": "./bin/capnpc-ts.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup",
    "prepack": "tsup",
    "prepublishOnly": "tsup",
    "test": "bun test --timeout 10000 test"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "dependencies": {
    "@haozeke/capnp": "^0.1.0-dev"
  },
  "license": "MIT",
  "files": ["bin", "dist", "README.md", "LICENSE"]
}
