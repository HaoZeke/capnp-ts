{
  "name": "@haozeke/capnp",
  "version": "0.1.0-dev",
  "description": "Pure TypeScript Cap'n Proto wire runtime (HaoZeke family)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./packed": {
      "bun": "./src/packed.ts",
      "types": "./dist/packed.d.ts",
      "import": "./dist/packed.js",
      "default": "./dist/packed.js"
    },
    "./canonical": {
      "bun": "./src/canonical.ts",
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js",
      "default": "./dist/canonical.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "license": "MIT",
  "sideEffects": false,
  "files": ["src", "dist", "LICENSE", "README.md"]
}
