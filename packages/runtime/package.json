{
  "name": "@haozeke/capnp",
  "version": "0.1.0",
  "description": "Pure TypeScript Cap'n Proto wire runtime (HaoZeke family)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoZeke/capnp-ts.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/HaoZeke/capnp-ts#readme",
  "bugs": {
    "url": "https://github.com/HaoZeke/capnp-ts/issues"
  },
  "bin": {
    "capnp-ts": "./bin/capnp-ts.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./packed": {
      "types": "./dist/packed.d.ts",
      "import": "./dist/packed.js",
      "default": "./dist/packed.js"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js",
      "default": "./dist/canonical.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./dynamic": {
      "types": "./dist/dynamic.d.ts",
      "import": "./dist/dynamic.js",
      "default": "./dist/dynamic.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "default": "./dist/json.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun run build && bun test --timeout 10000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup",
    "prepack": "tsup",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "license": "MIT",
  "sideEffects": false,
  "files": ["bin", "dist", "LICENSE", "README.md"]
}
