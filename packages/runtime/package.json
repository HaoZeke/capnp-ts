{
  "name": "@haozeke/capnp",
  "version": "0.1.0-dev",
  "description": "Pure TypeScript Cap'n Proto wire runtime (HaoZeke family)",
  "type": "module",
  "bin": {
    "capnp-ts": "./bin/capnp-ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./packed": {
      "bun": "./src/packed.ts",
      "types": "./dist/packed.d.ts",
      "import": "./dist/packed.js",
      "default": "./dist/packed.js"
    },
    "./canonical": {
      "bun": "./src/canonical.ts",
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js",
      "default": "./dist/canonical.js"
    },
    "./schema": {
      "bun": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./dynamic": {
      "bun": "./src/dynamic.ts",
      "types": "./dist/dynamic.d.ts",
      "import": "./dist/dynamic.js",
      "default": "./dist/dynamic.js"
    },
    "./text": {
      "bun": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    },
    "./json": {
      "bun": "./src/json.ts",
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "default": "./dist/json.js"
    },
    "./cli": {
      "bun": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup",
    "prepack": "tsup",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "license": "MIT",
  "sideEffects": false,
  "files": ["bin", "src", "dist", "LICENSE", "README.md"]
}
